<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MariVshApp.ViewModels.Admin"
             x:Class="MariVshApp.Views.Admin.AdminPage"
             x:DataType="vm:AdminViewModel"
             Title="Admin">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Grid Grid.Row="0" BackgroundColor="#6200EE" ColumnDefinitions="*,Auto" Padding="20,14">
            <Label Grid.Column="0" Text="AD IIOT — Admin" FontSize="20" FontAttributes="Bold"
                   TextColor="White" VerticalOptions="Center" />
            <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                <Label Text="{Binding UserName}" FontSize="13" TextColor="#D9FFFFFF"
                       VerticalOptions="Center" />
                <Button Text="Logout" Command="{Binding LogoutCommand}"
                        FontSize="13" BackgroundColor="#E53935" TextColor="White"
                        CornerRadius="6" Padding="14,6" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- BODY: Left Sidebar + Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*" BackgroundColor="#1E1E1E">

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" BackgroundColor="#141414"
                    Stroke="#2A2A2A" StrokeThickness="1">
                <VerticalStackLayout Spacing="0">

                    <!-- Sidebar Header -->
                    <Label Text="ADMIN PANEL" FontSize="10" FontAttributes="Bold"
                           TextColor="#666666"
                           Padding="20,20,20,12" />

                    <!-- Dashboard -->
                    <Border BackgroundColor="{Binding DashboardBg}"
                            Stroke="Transparent" StrokeThickness="0">
                        <Button Text="🏠  Dashboard"
                                Command="{Binding ShowDashboardCommand}"
                                FontSize="14" TextColor="{Binding DashboardFg}"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Fill"
                                Padding="20,12" BorderColor="Transparent" BorderWidth="0" />
                    </Border>

                    <!-- IoT Hub -->
                    <Border BackgroundColor="{Binding IotHubBg}"
                            Stroke="Transparent" StrokeThickness="0">
                        <Button Text="📡  IoT Hub"
                                Command="{Binding ShowIotHubCommand}"
                                FontSize="14" TextColor="{Binding IotHubFg}"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Fill"
                                Padding="20,12" BorderColor="Transparent" BorderWidth="0" />
                    </Border>

                    <!-- Divider -->
                    <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" Margin="0,8" />

                </VerticalStackLayout>
            </Border>

            <!-- CONTENT AREA -->
            <ScrollView Grid.Column="1" BackgroundColor="#1E1E1E">

                <!-- Dashboard Content -->
                <VerticalStackLayout IsVisible="{Binding IsDashboardVisible}"
                                     Padding="36,32" Spacing="16">
                    <Label Text="Dashboard" FontSize="24" FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Welcome to the Admin Dashboard." FontSize="14"
                           TextColor="#AAAAAA" />
                    <Label Text="{Binding WelcomeMessage}" FontSize="14"
                           TextColor="#BB86FC" />
                </VerticalStackLayout>

                <!-- IoT Hub Content -->
                <VerticalStackLayout IsVisible="{Binding IsIotHubVisible}"
                                     Padding="36,32" Spacing="16">
                    <Label Text="📡  IoT Hub" FontSize="24" FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Manage and monitor IoT Hub devices." FontSize="14"
                           TextColor="#AAAAAA" />

                    <Border BackgroundColor="#2A2A2A" Stroke="#383838" StrokeThickness="1"
                            StrokeShape="RoundRectangle 10" Padding="24" Margin="0,8,0,0">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Coming Soon" FontSize="16" FontAttributes="Bold"
                                   TextColor="#BB86FC" />
                            <Label Text="IoT Hub management — register hubs, sync component JSON, monitor connection status."
                                   FontSize="13" TextColor="#888888" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </ScrollView>

        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="2" BackgroundColor="#1A1A1A" ColumnDefinitions="*,Auto" Padding="20,8">
            <Label Grid.Column="0" Text="AD IIOT v1.0.0" FontSize="11"
                   TextColor="#666666" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Online" FontSize="11"
                   TextColor="#4CAF50" VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
